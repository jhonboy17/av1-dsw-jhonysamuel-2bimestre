# Configurações do Servidor
PORT=3000

# Banco de Dados (Prisma + MySQL/MariaDB)
# XAMPP (padrão): user=root e sem senha
DATABASE_URL="mysql://root:@localhost:3306/hospital_db"

# Alternativa: se estiver usando o docker-compose.yml deste backend
# DATABASE_URL="mysql://root:root@localhost:3306/hospital_db"

# JWT (para uso futuro)
# JWT_SECRET=sua_chave_secreta_aqui

# Ambiente
NODE_ENV=development
